{
  "name": "lingnan-youji-prototype",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "description": "岭南游纪 · 阶段2 原型（Vite 工程化版）· v0.5 统一应用：潮汕入口内嵌「英歌 · 上场之前」子应用",
  "scripts": {
    "predev": "npm run generate",
    "dev": "vite",
    "backend": "node backend/server.js",
    "test:api": "node --test tests-api/*.test.js",
    "build": "npm run generate && npm run check:seed && vite build",
    "preview": "vite preview",
    "generate": "node scripts/convert-geo.mjs && node scripts/generate-map.mjs && node yingge/scripts/convert-geo.mjs && node yingge/scripts/generate-map.mjs && node yingge/scripts/generate-hero.mjs",
    "check:seed": "node scripts/check-seed-refs.mjs && node yingge/scripts/check-seed-refs.mjs",
    "test:e2e": "playwright test",
    "test:e2e:yingge": "playwright test --config=playwright.yingge.config.js",
    "evidence": "playwright test --config=playwright.evidence.config.js",
    "evidence:yingge": "playwright test --config=playwright.yingge.evidence.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "topojson-server": "^3.0.1",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "motion": "^14.10.1",
    "topojson-client": "^3.1.0",
    "three": "^0.187.0"
  }
}